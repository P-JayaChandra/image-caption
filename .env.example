# VisionSpeak Configuration Template (Zero-API Offline Mode)
# Copy this file to .env for local overrides.
# NOTE: VisionSpeak runs 100% locally with zero cloud API keys.

# Server Configuration
PORT=5000
PYTHON_PORT=8000
HOST=127.0.0.1

# CORS allowed origins (comma-separated)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Offline AI Mode (100% Local Inference - No API keys required)
OFFLINE_MODE=true
MODEL_NAME=Salesforce/blip-image-captioning-base
DEVICE=auto
MAX_UPLOAD_SIZE_MB=10
DEFAULT_NUM_CAPTIONS=3
